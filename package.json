{
  "name": "@kitschpatrol/tweakpane-plugin-rotation",
  "version": "0.2.1-fork.1",
  "description": "Fork of tweakpane-plugin-rotation with build optimizations.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitschpatrol/tweakpane-plugin-rotation.git"
  },
  "homepage": "https://0b5vr.com/tweakpane-plugin-rotation",
  "author": "0b5vr",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=18.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.16.0 || >=26.3.0"
    }
  },
  "main": "dist/tweakpane-plugin-rotation.js",
  "type": "module",
  "maintainers": [
    {
      "name": "Eric Mika",
      "email": "eric@ericmika.com",
      "url": "https://ericmika.com"
    }
  ],
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "npm-package",
    "tweakpane",
    "tweakpane-plugin"
  ],
  "scripts": {
    "build:dev": "rollup --config rollup.config.js",
    "build:dts": "tsc --project src/tsconfig-dts.json",
    "build:prod": "rollup --config rollup.config.js --environment BUILD:production",
    "build": "pnpm run '/^build:/'",
    "clean": "shx rm -rf dist",
    "clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
    "format": "pnpm run '/^format:/'",
    "format:readme": "mdat expand",
    "format:ts": "eslint --ext .ts --fix \"src/**/*.ts\"",
    "prepare": "pnpm run clean && pnpm run build",
    "release": "pnpm test && pnpm build && bumpp --preid fork --commit 'Release: %s' --tag '%s' && NPM_TOKEN=$(op read 'op://Personal/npm/token') pnpm publish --tag latest",
    "server": "http-server -c-1 -o /index.html",
    "start": "pnpm run '/^(watch|server)$/'",
    "test": "eslint --ext .ts \"src/**/*.ts\" && mdat check",
    "version": "pnpm run clean && pnpm run build",
    "watch": "rollup --config rollup.config.js --watch --no-watch.clearScreen"
  },
  "peerDependencies": {
    "tweakpane": "^4.0.0"
  },
  "dependencies": {
    "@tweakpane/core": "^2.0.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "autoprefixer": "^10.6.1",
    "bumpp": "^12.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-sort-imports-es6-autofix": "^0.6.0",
    "globals": "^17.13.0",
    "http-server": "^14.1.1",
    "mdat": "^3.6.2",
    "postcss": "^8.5.30",
    "rollup": "^4.64.6",
    "rollup-plugin-cleanup": "^3.2.1",
    "sass": "^1.105.1",
    "shx": "^0.4.0",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
